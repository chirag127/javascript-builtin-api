{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JavaScript Built-ins",
  "description": "Every JavaScript built-in MDN tracks — 94 objects, namespaces and global functions covering 929 members — with a one-paragraph description, its member names, the ECMAScript anchor and first-support versions for Chrome, Firefox, Safari, Edge and Node.js.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "kind",
      "description",
      "status",
      "memberCount",
      "members",
      "specUrl",
      "mdnUrl",
      "support"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Dotted path in the global object",
        "example": "Intl.DateTimeFormat"
      },
      "name": {
        "type": "string",
        "description": "Same path",
        "example": "Intl.DateTimeFormat"
      },
      "kind": {
        "type": "string",
        "description": "Type of built-in, from the MDN page type",
        "example": "class",
        "enum": [
          "class",
          "function",
          "namespace",
          "global-property",
          "unknown"
        ]
      },
      "description": {
        "type": [
          "string",
          "null"
        ],
        "description": "First paragraph of the MDN page, links stripped",
        "example": "The Array object, as with arrays in other programming languages, enables storing a collection of multiple items under a single variable name."
      },
      "status": {
        "type": "string",
        "description": "Standardisation status from browser-compat-data",
        "example": "standard",
        "enum": [
          "standard",
          "experimental",
          "nonstandard",
          "deprecated",
          "obsolete"
        ]
      },
      "memberCount": {
        "type": "integer",
        "description": "Number of members browser-compat-data records",
        "example": 47
      },
      "members": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Member names, e.g. \"map\", \"@@iterator\", \"prototype\""
      },
      "specUrl": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "ECMAScript or proposal anchor"
      },
      "mdnUrl": {
        "type": [
          "string",
          "null"
        ],
        "description": "MDN reference page"
      },
      "support": {
        "type": "object",
        "description": "Browser support, one entry per engine",
        "properties": {
          "chrome": {
            "type": "object",
            "description": "First version of chrome that shipped the feature",
            "required": [
              "added",
              "removed"
            ],
            "properties": {
              "added": {
                "type": [
                  "string",
                  "boolean",
                  "null"
                ],
                "description": "Version string, false when unsupported, null when unrecorded"
              },
              "removed": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Version that dropped it"
              }
            },
            "additionalProperties": false
          },
          "firefox": {
            "type": "object",
            "description": "First version of firefox that shipped the feature",
            "required": [
              "added",
              "removed"
            ],
            "properties": {
              "added": {
                "type": [
                  "string",
                  "boolean",
                  "null"
                ],
                "description": "Version string, false when unsupported, null when unrecorded"
              },
              "removed": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Version that dropped it"
              }
            },
            "additionalProperties": false
          },
          "safari": {
            "type": "object",
            "description": "First version of safari that shipped the feature",
            "required": [
              "added",
              "removed"
            ],
            "properties": {
              "added": {
                "type": [
                  "string",
                  "boolean",
                  "null"
                ],
                "description": "Version string, false when unsupported, null when unrecorded"
              },
              "removed": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Version that dropped it"
              }
            },
            "additionalProperties": false
          },
          "edge": {
            "type": "object",
            "description": "First version of edge that shipped the feature",
            "required": [
              "added",
              "removed"
            ],
            "properties": {
              "added": {
                "type": [
                  "string",
                  "boolean",
                  "null"
                ],
                "description": "Version string, false when unsupported, null when unrecorded"
              },
              "removed": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Version that dropped it"
              }
            },
            "additionalProperties": false
          },
          "nodejs": {
            "type": "object",
            "description": "First version of nodejs that shipped the feature",
            "required": [
              "added",
              "removed"
            ],
            "properties": {
              "added": {
                "type": [
                  "string",
                  "boolean",
                  "null"
                ],
                "description": "Version string, false when unsupported, null when unrecorded"
              },
              "removed": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Version that dropped it"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "chrome",
          "firefox",
          "safari",
          "edge",
          "nodejs"
        ]
      }
    },
    "additionalProperties": false
  },
  "$id": "https://chirag127.github.io/javascript-builtin/schemas/data.json"
}
